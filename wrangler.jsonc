// Cloudflare Workers config (Workers Builds runs `npx wrangler deploy` with this).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masters-plan-site",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  // The filebin is a page on the main site: only /bin and below come to this
  // Worker. Every other path on that-geekyguy.xyz stays with the main site.
  "routes": [
    { "pattern": "that-geekyguy.xyz/bin", "zone_name": "that-geekyguy.xyz" },
    { "pattern": "that-geekyguy.xyz/bin/*", "zone_name": "that-geekyguy.xyz" }
  ],
  "assets": {
    // Vite builds into dist/bin/, so files are served at /bin/assets/...
    "directory": "./dist",
    "binding": "ASSETS",
    // No /bin -> /bin/ redirect; the Worker serves index.html for page paths.
    "html_handling": "none",
    // API and download paths always run the Worker; page paths (/bin/settings)
    // aren't files, so they fall through to the Worker, which serves the app.
    "run_worker_first": ["/bin/api/*", "/bin/f/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "filebin" }],
  // Hourly sweep of expired uploads (cron triggers are free).
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
