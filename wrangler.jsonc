// Cloudflare Workers config (Workers Builds runs `npx wrangler deploy` with this).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masters-plan-site",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deep links like /bin/settings get index.html; React picks the page.
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; everything else is served straight from dist/.
    "run_worker_first": ["/api/*", "/f/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "filebin" }],
  // Hourly sweep of expired uploads (cron triggers are free).
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
